# ========================================
# AutoCurriculo AI - Environment Variables
# ========================================

# Supabase (Dashboard > Project > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-public-anon-key>

# Supabase Service Role Key (Dashboard > Settings > API > service_role)
# Usado pelos webhooks do bot para bypassar RLS — NUNCA exponha no browser
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Bot API Key (string aleatoria para autenticar os webhooks)
BOT_API_KEY=<random-server-only-value>

# Chave aleatória de 32 bytes em base64 para criptografar conexões de plataformas.
# Gere fora do repositório e configure apenas em ambientes de servidor.
CONNECTION_ENCRYPTION_KEY=

# API URL (URL do deploy no Vercel)
API_URL=https://autocurriculo-ai.vercel.app

# Não use SESSION_STATE, e-mail ou senha de plataformas como variável global.
# Conexões individuais, quando suportadas, são criptografadas por usuário.
